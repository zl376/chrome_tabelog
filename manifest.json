{
  "manifest_version": 3,
  "name": "Tabelog Score Viewer",
  "version": "1.0.0",
  "description": "Displays Tabelog ratings when hovering over restaurants on omakase.in and tablecheck.com",
  "permissions": ["storage"],
  "host_permissions": [
    "https://tabelog.com/*",
    "https://omakase.in/*",
    "https://www.tablecheck.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://omakase.in/*",
        "https://www.tablecheck.com/*"
      ],
      "js": ["config.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
